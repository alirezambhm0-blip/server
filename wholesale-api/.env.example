# === Database ===
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# === JWT ===
# ⚠️ S13 — این مقدار اگر لو برود، هر کسی می‌تواند JWT معتبر برای هر کاربری
# (از جمله ADMIN) بسازد. حتماً بچرخانید و هرگز در ریپازیتوری/زیپ commit نکنید.
# HS256 حداقل ۳۲ بایت می‌خواهد. تولید با:  openssl rand -base64 48
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_48>
# P2-8 — این متغیر «مرده» نیست. کامنت قبلی می‌گفت خوانده نمی‌شود و UNVERIFIED بود؛
# بررسی و تست عملی نشان داد کاملاً فعال است:
#   src/auth/auth.module.ts:21 → config.get<string>('JWT_EXPIRES_IN') ?? '7d'
#   → داخل signOptions.expiresIn ثبت می‌شود، پس هر signAsync بدون expiresIn
#     از همین مقدار استفاده می‌کند.
# تست عملی: با مقدار 7d → exp-iat = 604800 ثانیه؛ با 1h → 3600 ثانیه.
# اگر حذفش کنید، انقضای توکن بی‌صدا به پیش‌فرض '7d' برمی‌گردد.
JWT_EXPIRES_IN="7d"

# === Server ===
PORT=3000
# برای development از development استفاده شود تا testCode در پاسخ request-otp برگردد.
# ⚠️ در زمان دیپلوی حتماً production شود، وگرنه کد OTP در پاسخ API برمی‌گردد
#    (auth.service.ts:164) → دور زدن کامل احراز هویت.
#    RELEASE-CHECKLIST.md خطوط ۶۵ و ۹۲ همین را در .env و systemd unit الزام کرده است.
NODE_ENV=development
# لیست origin های مجاز برای CORS (با کاما جدا کنید)
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000"

# === Business config ===
# ⚠️ S13 — هر دو کلید زیر در کد **صفر ارجاع** دارند (grep روی src/ تأیید شد).
# یعنی حداقل مبلغ سفارش و حداقل ارسال رایگان در حال حاضر enforce نمی‌شوند.
# حذف نشده‌اند (شاید بعداً استفاده شوند) ولی بدانید که اثری ندارند.
MIN_ORDER_AMOUNT=5000000
FREE_SHIPPING_MIN_AMOUNT=10000000

# === Admin ===
# شماره موبایل ادمین اولیه که seed script می‌سازد
ADMIN_PHONE="09000000000"

# === Visitors (test) ===
# شماره‌های موبایل ویزیتورهای تستی که seed script با نقش VISITOR می‌سازد/ارتقا می‌دهد
# فقط برای تست دستی (مثل تست IDOR) — در production خالی بگذارید تا چیزی ساخته نشود
VISITOR1_PHONE="09123456701"
VISITOR2_PHONE="09123456702"

# === Backup ===
BACKUP_DIR="./backups"
BACKUP_MAX_COUNT=10
BACKUP_INTERVAL="0 0 * * * *"

# === SMS (MeliPayamak) ===
# ⚠️ S13 — این سه کلید در sms.service.ts:43-45 خوانده می‌شوند
# ولی قبلاً در این فایل نمونه وجود نداشتند.
# تا وقتی NODE_ENV=production نشود، کد OTP واقعاً پیامک نمی‌شود
# و در پاسخ request-otp به‌صورت testCode برمی‌گردد.
MELIPAYAMAK_USERNAME="<REPLACE_ME_MELIPAYAMAK_USERNAME>"
MELIPAYAMAK_PASSWORD="<REPLACE_ME_MELIPAYAMAK_PASSWORD>"
MELIPAYAMAK_BODY_ID="<REPLACE_ME_MELIPAYAMAK_BODY_ID>"

# === Error reporting (اختیاری) ===
# ⚠️ S13 — در main.ts:17 خوانده می‌شود ولی قبلاً در این فایل نمونه نبود.
# خالی بگذارید تا Sentry خاموش بماند (رفتار فعلی).
SENTRY_DSN=""

# === Rate limiting (S1) ===
# ThrottlerGuard سراسری فعال است. همهٔ مقادیر از env خوانده می‌شوند.
#
# 🔵 مقادیر زیر = پیش‌فرض‌های ملایم development (باعث lockout نمی‌شوند).
# 🔴 برای production مقادیر پیشنهادی را در کامنت هر خط ببینید و جایگزین کنید.
#
# حد عمومی برای همهٔ ۱۱۷ endpoint
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000
# ارسال کد OTP — production پیشنهادی: 5 درخواست در ۱۵ دقیقه
OTP_REQUEST_LIMIT=20
OTP_REQUEST_TTL_MS=900000
# تایید کد OTP — production پیشنهادی: 10 حدس در ۱۵ دقیقه
OTP_VERIFY_LIMIT=50
OTP_VERIFY_TTL_MS=900000

# === Reverse proxy (S1) ===
# 🔴 مهم: پشت nginx باید 1 شود، وگرنه req.ip برای همهٔ کاربران آدرس proxy است
# و همه در یک سطل rate-limit می‌افتند (یعنی چند کاربر همزمان = قطعی).
# nginx شما X-Forwarded-For را می‌فرستد (RELEASE-CHECKLIST.md:124) پس آماده است.
#
# ⚠️ اگر سرویس **مستقیم** در معرض اینترنت است (بدون proxy) این را 0 بگذارید،
# وگرنه مهاجم با جعل هدر X-Forwarded-For محدودیت نرخ را دور می‌زند.
TRUST_PROXY=0
